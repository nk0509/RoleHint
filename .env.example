# Copy this file to .env.local for local work. Add the same values in Vercel for the live site.
# Never commit .env.local or paste your key into any file in public/.

# Required. Create it at https://aistudio.google.com
# Use a key from a project with billing on before real people use the site. Google may use
# free-tier data to improve its products, and people may review it.
GEMINI_API_KEY=

# Optional. Which Gemini model runs audits. Default: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.1-flash-lite

# Required on the live site: a shared counter for the limits below (free Upstash database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits. These numbers cap what the site can spend each day.
AUDITS_PER_VISITOR_PER_DAY=2
CHATS_PER_VISITOR_PER_DAY=15
AUDITS_PER_DAY_TOTAL=50
CHATS_PER_DAY_TOTAL=300

# Optional bot check with Cloudflare Turnstile. Leave blank to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local testing only: returns a canned report without calling the AI. Ignored on Vercel.
# MOCK_AI=1
